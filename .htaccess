# .htaccess for a Kirby site at the root of the domain
# Allowlist: only real files in assets/ and media/ (plus robots.txt, favicon.ico
# and .well-known) are served directly. Everything else goes to Kirby, including
# /panel, /api, the site pages and any file that shouldn't be public.

<IfModule mod_rewrite.c>

RewriteEngine on
RewriteBase /

# HTTPS: uncomment only if the server doesn't already redirect http:// to https://
# (if the browser says "too many redirects", comment it out again)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# index.php itself: stop here, so the rules don't loop
RewriteRule ^index\.php$ - [L]

# names starting with a dot (.git, .htaccess, .license…), except .well-known
RewriteRule (^|/)\.(?!well-known/) index.php [L]

# real files in assets/ (CSS, JS, fonts) and media/ (images, panel files)
RewriteCond %{REQUEST_URI} ^/(assets|media)/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# the few root files that browsers and certificates expect
RewriteCond %{REQUEST_URI} ^/(\.well-known/|robots\.txt$|favicon\.ico$)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# everything else goes to Kirby: pages, /panel, /api, thumbnails not generated yet,
# and content/, site/, kirby/, vendor/ and other files that shouldn't be public
RewriteRule ^ index.php [L]

</IfModule>


# Browser cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML, CSS and JS: the browser asks every time whether they've changed
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"

    # Images: one month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"

    # Fonts: one year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>


# Pass the Authorization header to PHP (the panel needs it to log in)
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1


# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE text/javascript
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# Security headers
<IfModule mod_headers.c>

# files of unknown type are shown as plain text
Header set Content-Type "text/plain" "expr=-z %{CONTENT_TYPE}"

# the browser must not guess file types
Header set X-Content-Type-Options "nosniff"

# pages can be shown in an iframe only on the same site (the panel preview needs this)
Header set X-Frame-Options "SAMEORIGIN"

# other sites see only the domain, not the full page address
Header set Referrer-Policy "strict-origin-when-cross-origin"

</IfModule>