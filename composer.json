{
	"name": "nereat2/maind-happy",
	"description": "Sito del progetto HAPPY (SUPSI / CSI), costruito con Kirby",
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
		"getkirby/cms": "^5.6"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	},
	"scripts": {
		"dev": [
			"Composer\\Config::disableProcessTimeout",
			"php -S localhost:8000 kirby/router.php"
		]
	}
}
