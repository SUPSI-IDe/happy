---
// Navigazione principale: logo a sinistra, voci a destra, una linea sotto (l'unico divisore della pagina).
// Su mobile le voci stanno dietro il pulsante menu. Senza JavaScript restano sempre visibili.
// Il colore del testo si adatta al fondo: carbone su bianco, bianco dentro un .su-colore.
const voci = [
	{ nome: 'Risorse', href: '/risorse' },
	{ nome: 'La Ricerca', href: '/ricerca' },
	{ nome: 'Il team', href: '/team' },
	{ nome: 'Contatti', href: '/contatti' },
];

const percorso = Astro.url.pathname;
const eAttiva = (href: string) => percorso === href || percorso.startsWith(`${href}/`);
---

<header class="navbar" data-navbar>
	<div class="contenitore riga">
		<a class="logo" href="/" aria-label="HAPPY, pagina iniziale">Happy</a>

		<button class="menu-bottone" type="button" aria-expanded="false" aria-controls="voci-navbar" data-menu-bottone>
			<span class="menu-icona" aria-hidden="true"></span>
			<span class="solo-screen-reader">Menu</span>
		</button>

		<nav class="voci" id="voci-navbar" aria-label="Principale">
			<ul>
				{
					voci.map((voce) => (
						<li>
							<a class="voce" href={voce.href} aria-current={eAttiva(voce.href) ? 'page' : undefined}>
								{voce.nome}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	const navbar = document.querySelector<HTMLElement>('[data-navbar]');
	const bottone = navbar?.querySelector<HTMLButtonElement>('[data-menu-bottone]');

	if (navbar && bottone) {
		const imposta = (aperto: boolean) => {
			navbar.toggleAttribute('data-aperto', aperto);
			bottone.setAttribute('aria-expanded', String(aperto));
		};

		bottone.addEventListener('click', () => imposta(!navbar.hasAttribute('data-aperto')));

		// Esc chiude il menu e riporta il focus sul pulsante
		navbar.addEventListener('keydown', (evento) => {
			if (evento.key === 'Escape' && navbar.hasAttribute('data-aperto')) {
				imposta(false);
				bottone.focus();
			}
		});
	}
</script>

<style>
	.navbar {
		border-block-end: var(--bordo-contorno) solid currentColor;
	}

	.riga {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		column-gap: var(--gutter);
		padding-block: var(--spazio-3);
	}

	.logo {
		color: inherit;
		font-family: var(--font-titoli);
		font-size: var(--text-logo);
		font-weight: var(--peso-grassetto);
		line-height: var(--interlinea-titoli);
		text-decoration: none;
	}

	/* Pulsante menu: visibile solo se c'è JavaScript e solo su mobile */
	.menu-bottone {
		display: none;
		align-items: center;
		justify-content: center;
		min-inline-size: var(--bottone-altezza-min);
		min-block-size: var(--bottone-altezza-min);
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	:global(.js) .menu-bottone {
		display: inline-flex;
	}

	/* Due linee, come nel wireframe. Da sostituire con il disegno a mano di Laura */
	.menu-icona {
		display: block;
		inline-size: var(--bottone-altezza-min);
		block-size: var(--spazio-2);
		border-block: var(--bordo-contorno) solid currentColor;
	}

	.voci {
		flex-basis: 100%;
	}

	.voci ul {
		display: flex;
		flex-direction: column;
		padding: 0;
		list-style: none;
	}

	:global(.js) .voci {
		display: none;
	}

	:global(.js) .navbar[data-aperto] .voci {
		display: block;
	}

	.voce {
		display: flex;
		align-items: center;
		min-block-size: var(--bottone-altezza-min);
		color: inherit;
		font-size: var(--text-corpo-colore);
		font-weight: var(--peso-grassetto);
		text-decoration: none;
	}

	.voce:hover {
		text-decoration: underline;
		text-decoration-thickness: var(--sottolineatura-bottone-hover);
		text-underline-offset: 0.25em;
	}

	/* Pagina corrente: sottolineatura provvisoria, poi il disegno a mano di Laura */
	.voce[aria-current='page'] {
		text-decoration: underline;
		text-decoration-thickness: var(--sottolineatura-spessore);
		text-underline-offset: 0.25em;
	}

	@media (min-width: 64rem) {
		:global(.js) .menu-bottone {
			display: none;
		}

		.voci,
		:global(.js) .voci {
			display: block;
			flex-basis: auto;
		}

		.voci ul {
			flex-direction: row;
			column-gap: var(--spazio-9);
		}
	}
</style>
